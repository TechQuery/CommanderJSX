{
    "name": "commander-jsx",
    "version": "0.8.0",
    "license": "LGPL-3.0",
    "description": "Command-line Arguments Parser with JSX support",
    "keywords": [
        "command-line",
        "arguments",
        "parameter",
        "parser",
        "jsx",
        "typescript"
    ],
    "author": "shiy2008@gmail.com",
    "homepage": "https://tech-query.me/CommanderJSX/",
    "bugs": {
        "url": "https://github.com/TechQuery/CommanderJSX/issues"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/TechQuery/CommanderJSX.git"
    },
    "main": "dist/index.js",
    "module": "dist/index.mjs",
    "source": "source/index.ts",
    "types": "dist/index.d.ts",
    "exports": {
        ".": {
            "require": "./dist/index.js",
            "import": "./dist/index.mjs",
            "types": "./dist/index.d.ts"
        },
        "./jsx-runtime": {
            "require": "./dist/jsx-runtime.js",
            "import": "./dist/jsx-runtime.mjs",
            "types": "./dist/jsx-runtime.d.ts"
        },
        "./jsx-dev-runtime": {
            "require": "./dist/jsx-dev-runtime.js",
            "import": "./dist/jsx-dev-runtime.mjs",
            "types": "./dist/jsx-dev-runtime.d.ts"
        }
    },
    "dependencies": {
        "@tech_query/node-toolkit": "^2.0.0-beta.3",
        "tslib": "^2.8.1",
        "web-utility": "^4.7.2"
    },
    "devDependencies": {
        "@types/node": "^24.13.6",
        "expect": "^30.5.2",
        "husky": "^9.1.7",
        "lint-staged": "^17.5.1",
        "open-cli": "^9.0.0",
        "pkgroll": "^2.28.1",
        "prettier": "^3.9.9",
        "tsx": "^4.23.15",
        "typedoc": "^0.28.20",
        "typedoc-plugin-mdn-links": "^5.1.1",
        "typescript": "~6.0.3"
    },
    "prettier": {
        "tabWidth": 4,
        "printWidth": 100,
        "trailingComma": "none",
        "arrowParens": "avoid",
        "singleQuote": true
    },
    "lint-staged": {
        "*.{md,json,yml,ts,tsx}": "prettier --write"
    },
    "scripts": {
        "prepare": "husky",
        "test": "lint-staged  &&  tsx --tsconfig test/tsconfig.json --test test/**/*.spec.*",
        "parcel": "pkgroll --srcdist source:dist",
        "build": "rm -rf dist/ docs/  &&  npm run parcel  &&  typedoc",
        "start": "typedoc source/  &&  open-cli docs/index.html",
        "prepublishOnly": "npm test  &&  npm run build"
    }
}
